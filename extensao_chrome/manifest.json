{
  "manifest_version": 3,
  "name": "Cortes 9:16",
  "version": "3.3",
  "key": "",
  "description": "Grava a live que você abrir, lê o chat, acha os melhores momentos e corta com um clique. Bot com IA embutido (Twitch, Kick e YouTube).",
  "permissions": [
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Cortes 9:16",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icone48.png",
      "128": "icone128.png"
    }
  },
  "icons": {
    "128": "icone128.png",
    "48": "icone48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://kick.com/*"
      ],
      "js": [
        "ui.js",
        "live.js"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "ui.js",
        "youtube.js"
      ]
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "ui.js",
        "instagram.js"
      ]
    }
  ]
}
